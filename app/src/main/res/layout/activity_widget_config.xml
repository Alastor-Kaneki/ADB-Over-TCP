<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configure ADB Widget"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="The Pair button opens Wireless Debugging and starts automatic endpoint discovery."
        android:textColor="#C7C7C7"
        android:textSize="14sp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/widgetStartShizuku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:checked="true"
        android:text="Start Shizuku after TCP setup"
        android:textColor="#FFFFFF" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/widgetForgetAfter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Remove this app from Paired devices afterward"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="When removal is enabled, the app intentionally loses ADB access after setup and must pair again next time."
        android:textColor="#BDBDBD"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveWidget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Add Widget" />
</LinearLayout>
